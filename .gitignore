# Dependencies — reinstalled from package.json, never committed
node_modules/
npm-debug.log*
yarn-error.log*

# Secrets / local config
.env
.env.*
!.env.example

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Build & scratch output
dist/
build/
*.log
tmp/

# Static yt-dlp / ffmpeg binaries fetched by server/scripts/install-tools.js at
# install time. Tens of MB, platform-specific, and reproducible from the pinned
# versions in that script — so they're built, not committed.
server/bin/
